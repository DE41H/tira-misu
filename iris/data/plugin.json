{
  "name": "tiramisu",
  "desc": "BITS Pilani campus events (classes, exams, deadlines, talks, club events) with their dates, times and venues, for a timetable.",
  "schema": {
    "type": "object",
    "properties": {
      "category": {
        "type": "string",
        "description": "Does this email announce something happening at a set date or time, and what kind of thing?",
        "enum": [
          "none",
          "class",
          "exam",
          "paper_distribution",
          "deadline",
          "talk",
          "workshop",
          "competition",
          "recruitment",
          "cultural",
          "sports",
          "meeting",
          "campus_service",
          "other_event"
        ]
      },
      "change": {
        "type": "string",
        "description": "Is this a new announcement, a change to an earlier one (new date, time or venue), a cancellation, or a reminder?",
        "enum": [
          "new",
          "changed",
          "cancelled",
          "reminder"
        ]
      },
      "audience": {
        "type": "string",
        "description": "Who is it for: only me or a few named people, my course or section, or everyone on campus?",
        "enum": [
          "me",
          "course",
          "everyone"
        ]
      },
      "multiple": {
        "type": "boolean",
        "description": "Does the email list several separate events or dates, like a schedule?"
      },
      "title": {
        "type": "string",
        "nullable": true,
        "description": "A short title for the event as a timetable entry, like 'CS F211 Midsem' or 'Quiz 2 deadline'. No greeting, sender or date. Null if there is no event."
      },
      "venue": {
        "type": "string",
        "nullable": true,
        "description": "Where it happens, as written: room, hall or building, like 'F105' or 'Main Auditorium'. 'Online' if only online. If changed, the new place. Null if not given."
      },
      "date": {
        "type": "string",
        "format": "date",
        "nullable": true,
        "description": "The day it happens or is due, if the email writes a calendar date (a day and month). Null for only today, tomorrow or a weekday. If changed, the new date."
      },
      "start": {
        "type": "string",
        "format": "time",
        "nullable": true,
        "description": "Start time on a 24-hour clock, like 09:30:00 or 17:00:00. For a deadline, the due time. If changed, the new time. Null if no time is given."
      },
      "end": {
        "type": "string",
        "format": "time",
        "nullable": true,
        "description": "End time on a 24-hour clock, like 17:00:00. Null if no end time is given."
      }
    }
  },
  "rules": {
    "title": "(?i)\\A(?:(?:re|fwd?|fw|subject|reminder|urgent|important)\\s*:\\s*|\\[[^\\]\\n]{1,40}\\]\\s*)*(?:\\d{5,}_[^:\\n]*:\\s*|new (?:announcement|material|assignment|question): \"?)?([^\\r\\n]+)",
    "course": "\\b([A-Z]{2,5}[ _-]?[FGH]\\d{3}|[FGH]\\d{3})\\b",
    "when": "(?i)([^\\n]{0,80}?\\b(?:\\d{1,2}(?:st|nd|rd|th)?\\s+(?:of\\s+)?(?:(?:jan|feb|mar|apr|may|jun|jul|aug|sep|oct|nov|dec)[a-z]*)\\b\\.?|(?:(?:jan|feb|mar|apr|may|jun|jul|aug|sep|oct|nov|dec)[a-z]*)\\b\\.?\\s*\\d{1,2}(?:st|nd|rd|th)?\\b|\\d{1,2}[./-]\\d{1,2}[./-](?:20)?\\d{2}|20\\d{2}-\\d{2}-\\d{2}|today|tonight|tomorrow|(?:mon|tues|wednes|thurs|fri|satur|sun)day)\\b[^\\n]{0,60})",
    "time": "(?i)\\b(\\d{1,2}(?:[:.]\\d{2})?\\s*(?:-|–|—|to|till|until)\\s*(?:\\d{1,2}(?:[:.]\\d{2})?\\s*(?:[ap]\\.?m\\b\\.?|noon\\b|hrs?\\b)|\\d{1,2}:\\d{2}\\b|[0-2]\\d[0-5]\\d\\s*hrs?\\b)|(?:\\d{1,2}(?:[:.]\\d{2})?\\s*(?:[ap]\\.?m\\b\\.?|noon\\b|hrs?\\b)|\\d{1,2}:\\d{2}\\b|[0-2]\\d[0-5]\\d\\s*hrs?\\b)(?:\\s*(?:-|–|—|to|till|until)\\s*(?:\\d{1,2}(?:[:.]\\d{2})?\\s*(?:[ap]\\.?m\\b\\.?|noon\\b|hrs?\\b)|\\d{1,2}:\\d{2}\\b|[0-2]\\d[0-5]\\d\\s*hrs?\\b))?|(?:12\\s*)?noon|midnight)",
    "venue": "(?im)(?:📍\\s*(?:venue|location)?\\s*[:\\-–]?|\\b(?:venue|location|place|where|room|hall)\\s*[:\\-–]|^(?:location|venue)\\s*\\n)[ \\t*]*([^\\n]{2,80})",
    "room": "(?i)\\b((?:NAB|FD[ -]?(?:I{1,3}|[123])|LTC|SAC|Rotunda|Clock Tower|Main Audi(?:torium)?|Auditorium|Library|Medical Cent(?:re|er)|Med-?C|Sky ?Lawns?|Gym ?G|[A-Z][a-z]+ (?:Mess|Bhawan|Bhavan)\\b)(?:\\s*[-,]?\\s*(?:room\\s*)?[A-Z]?\\d{3,4}(?:-?[A-Z])?)?)|\\b(?:room|rm\\.?|hall|in|at)\\s+(?:no\\.?\\s*)?((?:[A-Z]-?)?(?:[1-8]\\d{2}|[13-8]\\d{3}|2[1-9]\\d{2})(?:-[A-Z])?)\\b",
    "link": "(https?://(?:meet\\.google\\.com|(?:[\\w-]+\\.)?zoom\\.us|teams\\.microsoft\\.com|teams\\.live\\.com|(?:[\\w-]+\\.)?webex\\.com|forms\\.gle|docs\\.google\\.com/forms|forms\\.office\\.com|unstop\\.com|devfolio\\.co|lu\\.ma|youtu\\.be|(?:www\\.)?youtube\\.com/(?:live|watch))/?[^\\s<>\"'*)\\]]*)"
  }
}
